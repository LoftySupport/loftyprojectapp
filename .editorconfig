# One answer for whitespace, so a diff shows what changed rather than who edited it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown; trimming them changes the render.
trim_trailing_whitespace = false

[*.{sh,sql}]
indent_size = 2

[Makefile]
indent_style = tab

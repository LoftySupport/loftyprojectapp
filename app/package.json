{
  "name": "lofty-hub-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "dictionary": "node scripts/generate-dictionary.mjs",
    "build:montserrat": "node scripts/build-montserrat.mjs",
    "responsive": "node scripts/responsive.mjs",
    "export-check": "node --import ./scripts/register-ts.mjs scripts/export-check.ts",
    "check:pipeline": "node scripts/check-pipeline.mjs",
    "check:pipeline-order": "node scripts/check-pipeline-order.mjs",
    "check:process-move": "node scripts/check-process-move.mjs",
    "check:report-widgets": "node --import ./scripts/register-ts.mjs scripts/report-widgets-check.mjs",
    "check:share-password": "node --import ./scripts/register-ts.mjs scripts/share-password-check.mjs",
    "check:builder-dnd": "node scripts/check-builder-dnd.mjs",
    "check:import": "node scripts/check-import.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:capped-list": "node scripts/check-capped-list.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/server": "^1.5.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vibe/core": "^4.5.30",
    "@vibe/icons": "^4.1.0",
    "@vibe/tooltip": "^4.0.19",
    "docx": "^9.7.1",
    "dompurify": "^3.4.14",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "fontkit": "^2.0.4",
    "jsqr": "^1.4.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.57.0",
    "subset-font": "^2.7.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "@vibe/style": {
      "postcss": "^8.5.25"
    }
  }
}

{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "dictionary": "node scripts/generate-dictionary.mjs",
    "responsive": "node scripts/responsive.mjs",
    "export-check": "node --import ./scripts/register-ts.mjs scripts/export-check.ts",
    "check:pipeline": "node scripts/check-pipeline.mjs",
    "check:pipeline-order": "node scripts/check-pipeline-order.mjs",
    "check:process-move": "node scripts/check-process-move.mjs",
    "check:report-widgets": "node --import ./scripts/register-ts.mjs scripts/report-widgets-check.mjs",
    "check:share-password": "node --import ./scripts/register-ts.mjs scripts/share-password-check.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/server": "^1.5.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "@vercel/speed-insights": "^2.0.0",
    "@vibe/core": "^4.5.30",
    "@vibe/icons": "^4.1.0",
    "@vibe/tooltip": "^3.1.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.57.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "overrides": {
    "@vibe/style": {
      "postcss": "^8.5.25"
    }
  }
}
